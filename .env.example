# OpenAI API Key (required for agent LLM completions)
OPENAI_API_KEY=sk-...

# Stripe Sandbox / Test API Key (starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_...

# Brevo (Sendinblue) API Key (starts with xkeysib-...)
BREVO_API_KEY=xkeysib-...

# Brevo Sender Configuration
BREVO_SENDER_EMAIL=orders@thecopperfork.co.uk
BREVO_SENDER_NAME=The Copper Fork

# Optional: Default model (defaults to gpt-4.1)
AMVERIO_MODEL=gpt-4.1

# Amverio Client Admin Portal Credentials (Set secure credentials for production)
AMVERIO_ADMIN_USERNAME=admin
AMVERIO_ADMIN_PASSWORD=your_strong_secret_password_here
