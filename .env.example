# Brevo (Sendinblue) API Key (starts with xkeysib-...)
BREVO_API_KEY=xkeysib-...

# Brevo Sender Configuration
BREVO_SENDER_EMAIL=orders@thecopperfork.co.uk
BREVO_SENDER_NAME=The Copper Fork

# Dual-Tier Model Configuration
# Public demo visitors (cost-efficient, rate-limited guardrails):
AMVERIO_PUBLIC_MODEL=gpt-4o-mini
# Authenticated BA / Internal Client demo (premier model, unconstrained):
AMVERIO_PRO_MODEL=gpt-4o

# Amverio Client Admin Portal Credentials (Set secure credentials for production)
